{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Light Remote V4 Pilot",
  "version": "0.1.0",
  "identifier": "digital.thaiduy.lightremote.v4pilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Light Remote V4 — Pilot",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
