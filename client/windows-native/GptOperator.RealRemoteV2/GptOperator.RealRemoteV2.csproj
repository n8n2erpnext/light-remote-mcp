<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LightRemote.RM</AssemblyName>
    <RootNamespace>GptOperator.RealRemoteV2</RootNamespace>
    <Product>Light Remote RM</Product>
    <AssemblyTitle>Light Remote RM</AssemblyTitle>
    <Description>Light Remote Real Remote companion</Description>
    <Company>Light Remote</Company>
    <ApplicationIcon>Assets\light-remote-rm.ico</ApplicationIcon>
    <Version>0.10.1-dev.11</Version>
    <FileVersion>0.10.1.0</FileVersion>
    <AssemblyVersion>0.10.1.0</AssemblyVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="[3.8.3]" />
    <PackageReference Include="Vortice.DXGI" Version="[3.8.3]" />
    <PackageReference Include="Vortice.DirectX" Version="[3.8.3]" />
    <PackageReference Include="Vortice.Mathematics" Version="[2.1.0]" />
    <PackageReference Include="SharpGen.Runtime" Version="[2.4.2-beta]" />
    <PackageReference Include="SharpGen.Runtime.COM" Version="[2.4.2-beta]" />
    <PackageReference Include="System.Text.Json" Version="[10.0.15]" />
    <Resource Include="..\..\..\assets\fonts\web\GoogleSans-Variable.ttf" Link="Assets\GoogleSans-Variable.ttf" />
  </ItemGroup>
</Project>
