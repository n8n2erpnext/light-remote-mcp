{
  "schema": 1,
  "id": "backup-netlify",
  "role": "backup",
  "canonicalBranch": "backup/netlify",
  "transport": "netlify",
  "developmentAuthority": false,
  "inheritsFrom": "main",
  "requiredPaths": [
    "netlify.toml",
    "netlify/functions/operator.mts",
    "netlify/functions/_shared/operator-handler.cjs",
    "netlify/functions/_shared/plus-tool-helper.cjs",
    "netlify/functions/_shared/plus-batch-policy.cjs",
    "gateway/server.mjs",
    "operator-host/executor.mjs"
  ],
  "forbiddenPaths": [
    "plugin-server",
    "plugin.json",
    "mcp.json",
    "deploy/reviewer"
  ]
}
