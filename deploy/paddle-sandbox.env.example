# Light Remote Paddle Billing — Sandbox
# Copy these variables into /etc/light-remote-direct/plugin.env on the production LXD.
# Never commit real values. Restart light-remote-direct-plugin.service after editing.
#
# Paddle sandbox setup:
#   default payment link: https://light-remote.thaiduy.digital/account/billing
#   webhook destination: https://light-remote.thaiduy.digital/billing/paddle/webhook
#   recurring PRO price: USD 20 / month
#
# Required webhook events:
#   subscription.created
#   subscription.activated
#   subscription.updated
#   subscription.canceled
#   subscription.resumed
#   subscription.trialing
#   transaction.completed

LIGHT_REMOTE_PADDLE_ENV=sandbox
LIGHT_REMOTE_PADDLE_API_KEY=pdl_sdbx_apikey_REPLACE_IN_PLUGIN_ENV
LIGHT_REMOTE_PADDLE_CLIENT_TOKEN=test_REPLACE_IN_PLUGIN_ENV
LIGHT_REMOTE_PADDLE_PRO_PRICE_ID=pri_REPLACE_IN_PLUGIN_ENV
LIGHT_REMOTE_PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_IN_PLUGIN_ENV

# Optional. The default already matches the plugin systemd write boundary.
# LIGHT_REMOTE_PADDLE_STATE_FILE=/var/lib/light-remote-direct/plugin-state/paddle-billing.json
