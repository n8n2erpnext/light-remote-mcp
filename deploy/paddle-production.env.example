# Paddle Billing production configuration for Light Remote.
# Create the API key in Paddle Live > Developer tools > Authentication.
# Never commit or print real secret values.
LIGHT_REMOTE_PADDLE_ENV=production
LIGHT_REMOTE_PADDLE_CHECKOUT_ENABLED=false
LIGHT_REMOTE_PADDLE_API_KEY=pdl_live_apikey_REPLACE_IN_PLUGIN_ENV
LIGHT_REMOTE_PADDLE_CLIENT_TOKEN=live_REPLACE_IN_PLUGIN_ENV
LIGHT_REMOTE_PADDLE_PRO_PRICE_ID=pri_REPLACE_IN_PLUGIN_ENV
LIGHT_REMOTE_PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_IN_PLUGIN_ENV
# Enable checkout only after API auth, webhook verification, price preview, and one live canary purchase all pass.
