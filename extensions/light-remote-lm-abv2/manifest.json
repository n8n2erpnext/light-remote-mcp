{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Light Remote Memory",
  "short_name": "LR Memory",
  "version": "0.4.0",
  "description": "Review and save loaded ChatGPT/Claude context to your selected Light Remote device, then manually restore it to a new chat.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Light Remote LM",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://100.94.184.141/*"
  ]
}
