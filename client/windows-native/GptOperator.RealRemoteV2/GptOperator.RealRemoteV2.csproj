<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LightRemote.RM</AssemblyName>
    <RootNamespace>GptOperator.RealRemoteV2</RootNamespace>
    <Product>Light Remote RM</Product>
    <AssemblyTitle>Light Remote RM</AssemblyTitle>
    <Description>Light Remote Real Remote companion</Description>
    <Company>Light Remote</Company>
    <ApplicationIcon>Assets\light-remote-rm.ico</ApplicationIcon>
    <Version>0.9.0-rc.42</Version>
    <FileVersion>0.9.0.0</FileVersion>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
